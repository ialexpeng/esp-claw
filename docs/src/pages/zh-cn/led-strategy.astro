    <script define:vars={{ interactions }}>
      const catalog = interactions;
      const elements = { code: document.querySelector('#selected-code'), effectCode: document.querySelector('#effect-code'), title: document.querySelector('#effect-title'), summary: document.querySelector('#effect-summary'), led: document.querySelector('#effect-led'), ledLabel: document.querySelector('#effect-led-label'), rule: document.querySelector('#effect-rule'), key: document.querySelector('#effect-key'), buzzer: document.querySelector('#effect-buzzer') };
      const setRule = (ruleId) => {
        const item = catalog.find((rule) => rule.id === ruleId);
        if (!item) return;
        document.querySelectorAll('[data-rule]').forEach((button) => { const selected = button.dataset.rule === item.id; button.classList.toggle('is-selected', selected); button.setAttribute('aria-pressed', String(selected)); });
        document.querySelectorAll('[data-flow-id]').forEach((node) => node.classList.remove('is-highlighted'));
        item.targets.forEach((target) => document.querySelectorAll(`[data-flow-id="${target}"]`).forEach((node) => node.classList.add('is-highlighted')));
        elements.code.textContent = item.code; elements.effectCode.textContent = item.code; elements.title.textContent = item.title; elements.summary.textContent = item.summary;
        elements.led.className = `effect-led effect-led--${item.ledClass}`; elements.led.innerHTML = '<span></span>'; elements.ledLabel.textContent = item.led; elements.rule.textContent = item.rule; elements.key.textContent = item.key; elements.buzzer.textContent = item.buzzer;
        window.history.replaceState(null, '', `#${item.id}`);
      };
      document.querySelectorAll('[data-rule]').forEach((button) => button.addEventListener('click', () => setRule(button.dataset.rule)));
      const requested = window.location.hash.slice(1); setRule(catalog.some((item) => item.id === requested) ? requested : 'state-on');
    </script>
