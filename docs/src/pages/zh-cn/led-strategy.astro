---
import "../../styles/hardware-tokens.css";

const primaryStates = [
  {
    id: "power-off",
    index: "01",
    code: "POWER OFF",
    title: "关机",
    subtitle: "彻底断电 / 仅保留受限输入",
    tone: "offline",
    type: "独立系统状态",
    summary: "基础 LED 熄灭。只响应开机与恢复出厂；USB 充电仅在关机或休眠时覆盖 LED。",
    logics: [
      {
        id: "off-base",
        label: "彻底断电",
        trigger: "未插 USB，设备已关机",
        title: "基础关机",
        led: "LED 熄灭",
        ledClass: "off",
        behavior: "不显示运行或充电颜色；仅保留低功耗按键侦测。",
        result: "按住 1.5 秒可进入开机序列",
        key: "按住 1.5 秒：开机；按住 6 秒：进入恢复出厂检测",
        buzzer: "无独立提示音。成功开机后播放上升和旋 3 音节。",
      },
      {
        id: "charge-active",
        label: "USB + 有电池 / 充电中",
        trigger: "关机或休眠 + 插入 USB + 电池未满",
        title: "充电显示覆盖",
        led: "橙色常亮",
        ledClass: "orange-steady",
        behavior: "充电状态覆盖关机 / 休眠基础灯效；不是独立系统状态。",
        result: "充满后切换绿色常亮；拔出 USB 后恢复基础灯效",
        key: "沿用关机 / 休眠按键规则",
        buzzer: "未指定。",
      },
      {
        id: "charge-full",
        label: "USB + 有电池 / 已充满",
        trigger: "关机或休眠 + USB + 检测到充电完成",
        title: "充满显示覆盖",
        led: "绿色常亮",
        ledClass: "green-steady",
        behavior: "只表达“已充满”；开机后不再通过 LED 显示充电状态。",
        result: "拔出 USB 后恢复基础灯效",
        key: "沿用关机 / 休眠按键规则",
        buzzer: "未指定。",
      },
      {
        id: "charge-no-battery",
        label: "USB + 无电池",
        trigger: "关机或休眠 + USB + 未检测到电池",
        title: "无电池 USB 逻辑",
        led: "保持系统状态颜色",
        ledClass: "neutral",
        behavior: "不显示橙色或绿色充电灯色；关机基础态保持熄灭。",
        result: "插入电池后切换到有电池的充电策略",
        key: "沿用关机 / 休眠按键规则",
        buzzer: "未指定。",
      },
      {
        id: "low-start-block",
        label: "低电量开机阻止",
        trigger: "电量低于 20% 时尝试按住 1.5 秒开机",
        title: "启动守卫",
        led: "橙色慢闪",
        ledClass: "orange-slow",
        behavior: "重复提示电量不足，避免静默启动失败。",
        result: "保持关机，等待充电满足启动条件",
        key: "按住 1.5 秒：拒绝开机",
        buzzer: "未指定。",
      },
      {
        id: "factory-reset",
        label: "恢复出厂设置",
        trigger: "关机 → 按住 6 秒 → 插入 USB → 再保持 6 秒",
        title: "受保护复位",
        led: "LED 未指定（待确认）",
        ledClass: "neutral",
        behavior: "清除设置后转到“初始化 / 未配网”。",
        result: "进入初始化配网",
        key: "仅在上述连续动作完整成立时触发",
        buzzer: "滴 1 声。",
      },
    ],
  },
  {
    id: "init",
    index: "02",
    code: "INIT / UNPAIRED",
    title: "开机 · 初始化 / 未配网",
    subtitle: "开机、恢复出厂后的初始化路径",
    tone: "info",
    type: "独立系统状态",
    summary: "设备启动后进入初始化和配网；配网完成后进入系统空闲（Idle）。",
    logics: [
      {
        id: "boot-sequence",
        label: "开机序列",
        trigger: "关机 / 普通休眠状态下按住 1.5 秒",
        title: "启动音与初始化入口",
        led: "LED 交由下一阶段定义",
        ledClass: "neutral",
        behavior: "不额外定义过渡灯色，直接进入系统初始化。",
        result: "进入初始化配网",
        key: "开机过程中不单列按键策略",
        buzzer: "上升和旋 3 音节；听感方向参考 DJI Inspire 无人机开机。",
      },
      {
        id: "pairing",
        label: "初始化配网",
        trigger: "首次启动 / 恢复出厂完成 / 正常态重置配网",
        title: "未配网状态",
        led: "蓝色快闪",
        ledClass: "blue-fast",
        behavior: "蓝色快闪表示正在初始化和配网；应同时显示“正在配网”文字。",
        result: "配网完成后进入系统空闲（Idle）",
        key: "正常运行态按住 6 秒：重新进入配网",
        buzzer: "未指定。",
      },
    ],
  },
  {
    id: "debug",
    index: "03",
    code: "DEBUG",
    title: "开机 · 调试模式",
    subtitle: "以主机连接状态决定子逻辑",
    tone: "accent",
    type: "独立系统状态",
    summary: "调试模式的主状态保持不变；上位机连接与否决定绿色常亮或彩虹呼吸。",
    logics: [
      {
        id: "host-offline",
        label: "上位机未连接",
        trigger: "进入调试模式，但未建立主机链路",
        title: "调试待连接",
        led: "绿色常亮",
        ledClass: "green-steady",
        behavior: "表示调试模式已就绪，但不能代表主机已连接。",
        result: "主机建立连接后切换为彩虹呼吸",
        key: "按住 1.5 秒：关机；按住 6 秒：重置配网",
        buzzer: "关机时播放下降和旋 3 音节。",
      },
      {
        id: "host-linked",
        label: "上位机已连接",
        trigger: "调试模式中主机链路建立",
        title: "调试已连接",
        led: "彩虹呼吸",
        ledClass: "rainbow-breathe",
        behavior: "只用于“调试模式 + 上位机已连接”的组合状态。",
        result: "主机断开后回到绿色常亮",
        key: "按住 1.5 秒：关机；按住 6 秒：重置配网",
        buzzer: "关机时播放下降和旋 3 音节。",
      },
    ],
  },
  {
    id: "program",
    index: "04",
    code: "USER PROGRAM",
    title: "开机 · 用户程序",
    subtitle: "用户业务正在运行",
    tone: "accent",
    type: "独立系统状态",
    summary: "用户程序运行期间 LED 为白色常亮；告警与错误可临时覆盖 LED，不改写程序状态。",
    logics: [
      {
        id: "program-running",
        label: "用户程序运行",
        trigger: "从 Idle 启动用户任务",
        title: "运行态",
        led: "白色常亮",
        ledClass: "white-steady",
        behavior: "白色常亮表达用户程序正在执行；开机状态不显示充电灯色。",
        result: "程序结束后进入系统空闲（Idle）",
        key: "按住 1.5 秒：关机；按住 6 秒：重置配网",
        buzzer: "关机时播放下降和旋 3 音节。",
      },
      {
        id: "peripheral-hotplug",
        label: "外设热插入",
        trigger: "用户程序运行中检测到外设插入",
        title: "热插入反馈",
        led: "保持白色常亮",
        ledClass: "white-steady",
        behavior: "不改变用户程序的主状态或常规 LED 输出。",
        result: "继续运行用户程序",
        key: "按键策略不变",
        buzzer: "短促上升和弦，2 音节。",
      },
    ],
  },
  {
    id: "idle",
    index: "05",
    code: "IDLE",
    title: "开机 · 系统空闲（Idle）",
    subtitle: "正常待机与任务入口",
    tone: "accent",
    type: "独立系统状态",
    summary: "系统正常、未运行用户程序时的空闲态；LED 采用建议的低幅绿色呼吸。",
    logics: [
      {
        id: "idle-ready",
        label: "系统空闲",
        trigger: "初始化配网完成 / 用户程序结束",
        title: "可用待机",
        led: "绿色呼吸（建议）",
        ledClass: "green-breathe",
        behavior: "建议用低幅绿色呼吸替代原先待定的“熄灭”，明确设备已正常可用。",
        result: "可启动用户程序或进入调试模式",
        key: "按住 1.5 秒：关机；按住 6 秒：重置配网",
        buzzer: "关机时播放下降和旋 3 音节。",
      },
      {
        id: "idle-reset-pairing",
        label: "重置配网",
        trigger: "Idle 状态下按住 6 秒",
        title: "重新配网入口",
        led: "蓝色快闪",
        ledClass: "blue-fast",
        behavior: "该操作替代旧版“双击按钮重置配网”。",
        result: "进入初始化 / 未配网",
        key: "按住 6 秒：重置配网",
        buzzer: "未指定。",
      },
    ],
  },
  {
    id: "warning",
    index: "06",
    code: "WARNING OVERLAY",
    title: "开机 · 系统告警",
    subtitle: "仅覆盖 LED，不改变原有运行状态",
    tone: "warning",
    type: "LED 覆盖状态",
    summary: "告警覆盖当前的 Idle、用户程序或调试主状态；告警解除后应回到原状态的 LED 输出。",
    logics: [
      {
        id: "notice-low20",
        label: "提醒级告警",
        trigger: "电量低于 20% 或其他弱提示",
        title: "可继续运行的提醒",
        led: "橙色慢闪",
        ledClass: "orange-slow",
        behavior: "只覆盖 LED；Idle、用户程序或调试模式本身不发生状态改变。",
        result: "提示解除后恢复原主状态 LED",
        key: "沿用被覆盖主状态的按键策略",
        buzzer: "未指定。",
      },
      {
        id: "notice-low5",
        label: "临界低电量",
        trigger: "电量低于 5%",
        title: "自动休眠倒计时",
        led: "橙色快闪 10 秒",
        ledClass: "orange-fast",
        behavior: "告警覆盖持续 10 秒；倒计时结束后，系统退出开机态并进入休眠。",
        result: "10 秒后进入低电量休眠",
        key: "倒计时期间未定义额外按键策略",
        buzzer: "未指定。",
      },
      {
        id: "low-power-sleep",
        label: "低电量休眠后的开机尝试",
        trigger: "已低电量休眠，再按住 1.5 秒",
        title: "低电量启动阻止",
        led: "橙色慢闪",
        ledClass: "orange-slow",
        behavior: "用重复橙色慢闪说明当前不是普通休眠，不允许直接开机。",
        result: "保持休眠，等待 USB 充电",
        key: "按住 1.5 秒：拒绝开机",
        buzzer: "未指定。",
      },
    ],
  },
  {
    id: "upgrade",
    index: "07",
    code: "UPGRADE",
    title: "开机 · 系统升级",
    subtitle: "不可打断的系统操作",
    tone: "danger",
    type: "独立保护状态",
    summary: "系统升级期间按键完全锁定；完成后回到进入升级前的开机主状态。",
    logics: [
      {
        id: "upgrade-running",
        label: "升级进行中",
        trigger: "开始系统升级或其他不可打断操作",
        title: "升级保护",
        led: "红色慢闪",
        ledClass: "red-slow",
        behavior: "红色慢闪明确提示当前操作不可中断。",
        result: "操作完成后返回升级前的开机主状态",
        key: "所有按键操作：不响应",
        buzzer: "未指定。",
      },
    ],
  },
  {
    id: "error",
    index: "08",
    code: "ERROR",
    title: "开机 · 系统错误",
    subtitle: "高温或系统不可正常工作",
    tone: "danger",
    type: "独立保护状态",
    summary: "系统不可继续正常工作时进入 Error；只允许执行关机操作。",
    logics: [
      {
        id: "fatal-error",
        label: "致命错误",
        trigger: "高温错误或系统无法正常工作的错误态",
        title: "错误保护",
        led: "红色快闪",
        ledClass: "red-fast",
        behavior: "错误灯效优先于所有正常运行灯效，提示用户停止继续使用。",
        result: "关机操作后回到关机状态",
        key: "仅响应关机操作；其他按键不响应",
        buzzer: "与恢复出厂相同的音调音节，短促连续播放 3 遍。",
      },
    ],
  },
];

const initialPrimary = primaryStates.find((state) => state.id === "idle")!;
const initialLogic = initialPrimary.logics[0];
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="ESP-Claw 八个主系统状态及其 LED、按键与蜂鸣器子逻辑。" />
    <title>系统状态与 LED 指示策略 | ESP-Claw</title>
  </head>
  <body>
    <main class="system-page">
      <header class="page-header">
        <div class="eyebrow-row">
          <span class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>ESP-CLAW / SYSTEM POLICY</span>
          <span class="revision">八主状态 · REV 0.2 · 2026-09</span>
        </div>
        <div class="hero-grid">
          <div>
            <p class="kicker">STATE → SUB-LOGIC → EFFECT</p>
            <h1>系统状态与 LED 指示策略</h1>
            <p class="hero-copy">先选择一个<strong>主系统状态</strong>，再选择右侧的<strong>子逻辑</strong>。下方流程会同步高亮当前步骤，右侧显示 LED、按键与蜂鸣器效果。</p>
          </div>
          <aside class="decision-card" aria-label="页面使用说明">
            <span class="decision-label">阅读方式</span>
            <strong>顶部定主状态，右侧选子逻辑，左侧看一条完整流程。</strong>
            <p>系统告警仅覆盖 LED；解除后恢复原运行状态的灯效。</p>
            <a class="hw-button-primary source-action" href="/led-strategy-flow.mmd" download>
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3v11m0 0 4-4m-4 4-4-4M5 17v3h14v-3" /></svg>
              下载流程图源码
            </a>
            <a class="source-graphic" href="/led-strategy-flow.png" target="_blank" rel="noreferrer">查看传统流程图 PNG ↗</a>
          </aside>
        </div>
      </header>

      <section class="primary-section" aria-labelledby="primary-heading">
        <div class="section-heading primary-heading">
          <div>
            <p class="section-eyebrow">01 / PRIMARY SYSTEM STATES</p>
            <h2 id="primary-heading">八个主系统状态</h2>
          </div>
          <p>点击主状态以切换下方的子逻辑流程。</p>
        </div>
        <div class="primary-grid" role="list" aria-label="主系统状态">
          {primaryStates.map((state) => (
            <button
              type="button"
              class={`primary-state primary-state--${state.tone}${state.id === initialPrimary.id ? " is-selected" : ""}`}
              data-primary={state.id}
              aria-pressed={state.id === initialPrimary.id ? "true" : "false"}
            >
              <span class="primary-index">{state.index}</span>
              <span class="primary-content"><strong>{state.title}</strong><span>{state.subtitle}</span></span>
              <span class={`state-mark state-mark--${state.tone}`} aria-hidden="true"></span>
            </button>
          ))}
        </div>
        <div class="status-note"><span class="status-note-dot" aria-hidden="true"></span><strong>系统告警</strong>为 LED 覆盖状态：它不重置 Idle、用户程序或调试模式；告警解除后恢复原主状态。</div>
      </section>

      <section class="strategy-workspace" aria-label="主状态、子逻辑与效果联动">
        <section class="hw-card flow-card" aria-labelledby="flow-heading">
          <div class="section-heading">
            <div>
              <p class="section-eyebrow">02 / FLOW LOGIC</p>
              <h2 id="flow-heading">当前主状态的子逻辑</h2>
            </div>
            <span id="flow-state-type" class="scope-pill scope-pill--accent">{initialPrimary.type}</span>
          </div>

          <div class="active-state-bar">
            <span id="flow-state-index" class="active-state-index">{initialPrimary.index}</span>
            <div><span id="flow-state-code" class="flow-state-code">{initialPrimary.code}</span><strong id="flow-state-title">{initialPrimary.title}</strong></div>
            <p id="flow-state-summary">{initialPrimary.summary}</p>
          </div>

          <div class="logic-flow" aria-live="polite">
            <article class="flow-step" data-flow-step="trigger">
              <span class="flow-number">01</span>
              <span class="flow-caption">触发 / 条件</span>
              <strong id="flow-trigger">{initialLogic.trigger}</strong>
            </article>
            <span class="flow-arrow" aria-hidden="true"><i></i></span>
            <article class="flow-step flow-step--active" data-flow-step="logic">
              <span class="flow-number">02</span>
              <span class="flow-caption">当前子逻辑</span>
              <strong id="flow-logic">{initialLogic.title}</strong>
              <span id="flow-logic-label" class="flow-tag">{initialLogic.label}</span>
            </article>
            <span class="flow-arrow" aria-hidden="true"><i></i></span>
            <article class="flow-step" data-flow-step="led">
              <span class="flow-number">03</span>
              <span class="flow-caption">LED 输出</span>
              <span id="flow-led-lamp" class={`flow-lamp flow-lamp--${initialLogic.ledClass}`} aria-hidden="true"><span></span></span>
              <strong id="flow-led">{initialLogic.led}</strong>
            </article>
            <span class="flow-arrow" aria-hidden="true"><i></i></span>
            <article class="flow-step" data-flow-step="result">
              <span class="flow-number">04</span>
              <span class="flow-caption">结果 / 下一步</span>
              <strong id="flow-result">{initialLogic.result}</strong>
            </article>
          </div>

          <div class="flow-rule-grid">
            <div class="flow-rule"><span class="rule-code">POWER</span><p>USB 充电只在<strong>关机 / 休眠</strong>时覆盖 LED；所有开机态不显示充电色。</p></div>
            <div class="flow-rule"><span class="rule-code">KEY</span><p>正常开机态：<strong>1.5 秒关机、6 秒重置配网</strong>；升级锁键，错误仅可关机。</p></div>
            <div class="flow-rule"><span class="rule-code">LOW BAT</span><p>电量 &lt; 5%：<strong>橙色快闪 10 秒</strong>，随后进入低电量休眠。</p></div>
          </div>
        </section>

        <aside class="hw-card effect-card" aria-labelledby="effect-heading" aria-live="polite">
          <div class="effect-card-topline">
            <div><p class="section-eyebrow">03 / EFFECT PREVIEW</p><h2 id="effect-heading">选择子逻辑</h2></div>
            <span id="effect-code" class="effect-code">{initialPrimary.code}</span>
          </div>
          <p id="effect-instruction" class="effect-instruction">选择当前主状态下的一条逻辑；左侧流程会同步高亮。</p>
          <div id="logic-options" class="logic-options" role="list" aria-label="当前主状态的子逻辑"></div>

          <section class="effect-output" aria-label="LED 效果预览">
            <div class="effect-output-heading"><span>LED EFFECT</span><strong id="effect-led-label">{initialLogic.led}</strong></div>
            <div class="effect-led-body">
              <span id="effect-led" class={`effect-led effect-led--${initialLogic.ledClass}`} aria-hidden="true"><span></span></span>
              <p id="effect-behavior">{initialLogic.behavior}</p>
            </div>
          </section>

          <section class="effect-detail">
            <div class="detail-heading"><span>BUTTON RESPONSE</span><span></span></div>
            <p id="effect-key">{initialLogic.key}</p>
          </section>
          <section class="effect-detail">
            <div class="detail-heading"><span>BUZZER</span><span></span></div>
            <p id="effect-buzzer">{initialLogic.buzzer}</p>
          </section>
          <p class="audio-placeholder"><span aria-hidden="true">◌</span> 音频样本待接入。上传 MP3、WAV、M4A 或 WebM 后，可将对应蜂鸣器策略接为可试听音效。</p>
        </aside>
      </section>

      <section class="compact-reference" aria-labelledby="reference-heading">
        <div>
          <p class="section-eyebrow">IMPLEMENTATION REFERENCE</p>
          <h2 id="reference-heading">两个待产品确认项</h2>
        </div>
        <p><strong>Idle</strong> 当前按建议使用绿色呼吸；若最终确定为 LED 熄灭，只需调整 Idle 子逻辑。<strong>恢复出厂设置</strong>仅定义了“滴 1 声”，未定义 LED 颜色，因此保留为“未指定”。</p>
      </section>

      <footer class="page-footer">
        <span>ESP-CLAW · SYSTEM LED POLICY MAP</span>
        <span>主状态与子逻辑均支持鼠标、触控和键盘操作。</span>
      </footer>
    </main>

    <script define:vars={{ primaryStates }}>
      const catalog = primaryStates;
      const initialPrimaryId = 'idle';
      const elements = {
        stateType: document.querySelector('#flow-state-type'),
        stateIndex: document.querySelector('#flow-state-index'),
        stateCode: document.querySelector('#flow-state-code'),
        stateTitle: document.querySelector('#flow-state-title'),
        stateSummary: document.querySelector('#flow-state-summary'),
        trigger: document.querySelector('#flow-trigger'),
        logic: document.querySelector('#flow-logic'),
        logicLabel: document.querySelector('#flow-logic-label'),
        flowLamp: document.querySelector('#flow-led-lamp'),
        flowLed: document.querySelector('#flow-led'),
        result: document.querySelector('#flow-result'),
        effectCode: document.querySelector('#effect-code'),
        instruction: document.querySelector('#effect-instruction'),
        options: document.querySelector('#logic-options'),
        effectLedLabel: document.querySelector('#effect-led-label'),
        effectLed: document.querySelector('#effect-led'),
        behavior: document.querySelector('#effect-behavior'),
        key: document.querySelector('#effect-key'),
        buzzer: document.querySelector('#effect-buzzer'),
      };

      let selectedPrimary = catalog.find((state) => state.id === initialPrimaryId) || catalog[0];
      let selectedLogic = selectedPrimary.logics[0];

      const toneClass = (tone) => tone === 'accent' ? 'accent' : tone;

      const renderOptions = () => {
        elements.options.innerHTML = selectedPrimary.logics.map((logic, index) => `
          <button type="button" class="logic-option${logic.id === selectedLogic.id ? ' is-selected' : ''}" data-logic="${logic.id}" aria-pressed="${logic.id === selectedLogic.id}">
            <span class="logic-option-index">${String(index + 1).padStart(2, '0')}</span>
            <span><strong>${logic.label}</strong><small>${logic.title}</small></span>
            <span class="logic-option-check" aria-hidden="true">✓</span>
          </button>`).join('');
        elements.options.querySelectorAll('[data-logic]').forEach((button) => {
          button.addEventListener('click', () => setLogic(button.dataset.logic, true));
        });
      };

      const setLogic = (logicId, focusFlow = false) => {
        const logic = selectedPrimary.logics.find((item) => item.id === logicId);
        if (!logic) return;
        selectedLogic = logic;
        elements.trigger.textContent = logic.trigger;
        elements.logic.textContent = logic.title;
        elements.logicLabel.textContent = logic.label;
        elements.flowLamp.className = `flow-lamp flow-lamp--${logic.ledClass}`;
        elements.flowLamp.innerHTML = '<span></span>';
        elements.flowLed.textContent = logic.led;
        elements.result.textContent = logic.result;
        elements.effectLedLabel.textContent = logic.led;
        elements.effectLed.className = `effect-led effect-led--${logic.ledClass}`;
        elements.effectLed.innerHTML = '<span></span>';
        elements.behavior.textContent = logic.behavior;
        elements.key.textContent = logic.key;
        elements.buzzer.textContent = logic.buzzer;
        renderOptions();
        window.history.replaceState(null, '', `#${selectedPrimary.id}/${logic.id}`);
        if (focusFlow) document.querySelector('[data-flow-step="logic"]').scrollIntoView({ behavior: 'smooth', block: 'center' });
      };

      const setPrimary = (primaryId) => {
        const state = catalog.find((item) => item.id === primaryId);
        if (!state) return;
        selectedPrimary = state;
        selectedLogic = state.logics[0];
        document.querySelectorAll('[data-primary]').forEach((button) => {
          const selected = button.dataset.primary === state.id;
          button.classList.toggle('is-selected', selected);
          button.setAttribute('aria-pressed', String(selected));
        });
        elements.stateType.textContent = state.type;
        elements.stateType.className = `scope-pill scope-pill--${toneClass(state.tone)}`;
        elements.stateIndex.textContent = state.index;
        elements.stateCode.textContent = state.code;
        elements.stateTitle.textContent = state.title;
        elements.stateSummary.textContent = state.summary;
        elements.effectCode.textContent = state.code;
        elements.instruction.textContent = `已选择「${state.title}」。选择下方一条子逻辑，左侧流程与右侧效果会同步更新。`;
        setLogic(selectedLogic.id, false);
      };

      document.querySelectorAll('[data-primary]').forEach((button) => {
        button.addEventListener('click', () => setPrimary(button.dataset.primary));
      });

      const [requestedPrimary, requestedLogic] = window.location.hash.slice(1).split('/');
      if (catalog.some((state) => state.id === requestedPrimary)) {
        setPrimary(requestedPrimary);
        if (requestedLogic) setLogic(requestedLogic, false);
      } else {
        setPrimary(initialPrimaryId);
      }
    </script>
  </body>
</html>

