---
import "../../styles/hardware-tokens.css";

const interactions = [
  {
    id: "state-off", group: "system", code: "SYSTEM STATE", title: "关机", short: "彻底断电",
    summary: "系统彻底断电，基础 LED 熄灭；仅接受开机和恢复出厂的受限输入。",
    targets: ["state-off"], led: "LED 熄灭", ledClass: "off",
    rule: "未插 USB 时不显示运行或充电颜色。插入 USB 后，是否显示充电颜色取决于是否检测到电池。",
    key: "响应：按住 1.5 秒尝试开机；或执行恢复出厂连续动作。", buzzer: "无独立提示音。", tone: "neutral",
  },
  {
    id: "state-on", group: "system", code: "SYSTEM STATE", title: "开机", short: "基础运行 / Idle",
    summary: "开机后的基础运行状态；初始化配网完成、调试退出和用户程序结束均回到这里。",
    targets: ["state-on"], led: "绿色呼吸（建议）", ledClass: "green-breathe",
    rule: "这是原“正常 Idle”状态。若最终决定熄灭 LED，只需替换此状态的 LED 输出，不影响其它链路。",
    key: "按住 1.5 秒：关机；按住 6 秒：重新初始化配网。", buzzer: "关机时播放下降和旋 3 音节。", tone: "neutral",
  },
  {
    id: "state-sleep", group: "system", code: "SYSTEM STATE", title: "休眠", short: "普通 / 低电量休眠",
    summary: "系统处于低功耗休眠，基础 LED 熄灭；普通休眠可启动，低电量休眠会拒绝启动。",
    targets: ["state-sleep"], led: "LED 熄灭（基础）", ledClass: "off",
    rule: "插入 USB 且有电池时，充电中显示橙色常亮、充满显示绿色常亮；无电池时维持基础状态显示。",
    key: "按住 1.5 秒尝试开机。普通休眠进入初始化配网；低电量休眠保持休眠。", buzzer: "允许开机时播放上升和旋 3 音节。", tone: "neutral",
  },
  {
    id: "sub-pairing", group: "substate", code: "ON SUBSTATE", title: "初始化配网", short: "初始化 / 未配网",
    summary: "首次启动、普通休眠唤醒、恢复出厂及重新配网都会进入此子状态。",
    targets: ["sub-pairing"], led: "蓝色快闪", ledClass: "blue-fast",
    rule: "配网完成后进入开机基础运行状态。低电量告警可覆盖配网时的 LED，但不会改变配网任务本身。",
    key: "配网完成：自动回到开机基础运行。", buzzer: "允许开机时播放上升和旋 3 音节；配网过程没有已定义的额外音效。", tone: "neutral",
  },
  {
    id: "sub-debug", group: "substate", code: "ON SUBSTATE", title: "调试模式", short: "根据上位机连接切换输出",
    summary: "调试模式是开机子状态；上位机连接与断开只改变 LED 输出，不改变调试模式本身。",
    targets: ["sub-debug", "decision-host-connected", "debug-host-disconnected", "debug-host-connected"], led: "连接状态决定 LED", ledClass: "neutral",
    rule: "上位机未连接显示绿色常亮；已连接显示彩虹呼吸。退出调试后回到开机基础运行状态。",
    key: "按住 1.5 秒：关机；按住 6 秒：重新初始化配网。", buzzer: "关机时播放下降和旋 3 音节。", tone: "neutral",
  },
  {
    id: "debug-host-disconnected", group: "substate", code: "DEBUG DETAIL", title: "调试：上位机未连接", short: "调试模式的未连接分支",
    summary: "调试模式仍在运行，但上位机未连接，因此采用静态的调试指示。",
    targets: ["sub-debug", "decision-host-connected", "debug-host-disconnected"], led: "绿色常亮", ledClass: "green-steady",
    rule: "上位机连接后立即切换到彩虹呼吸；调试模式本身不退出。", key: "沿用调试模式按键规则。", buzzer: "未指定。", tone: "neutral",
  },
  {
    id: "debug-host-connected", group: "substate", code: "DEBUG DETAIL", title: "调试：上位机已连接", short: "调试模式的已连接分支",
    summary: "上位机已经接入，调试模式以彩虹呼吸表示通信已建立。",
    targets: ["sub-debug", "decision-host-connected", "debug-host-connected"], led: "彩虹呼吸", ledClass: "rainbow-breathe",
    rule: "断开上位机后切换回绿色常亮；调试模式本身不退出。", key: "沿用调试模式按键规则。", buzzer: "未指定。", tone: "neutral",
  },
  {
    id: "sub-program", group: "substate", code: "ON SUBSTATE", title: "用户程序运行", short: "用户任务执行中",
    summary: "用户程序运行时 LED 白色常亮；程序结束后回到开机基础运行状态。",
    targets: ["sub-program"], led: "白色常亮", ledClass: "white-steady",
    rule: "外设热插入是该状态内的事件，不会改变程序运行状态或白色常亮输出。",
    key: "按住 1.5 秒：关机；按住 6 秒：重新初始化配网。", buzzer: "热插入时播放短促上升和弦 2 音节；关机时播放下降和旋 3 音节。", tone: "neutral",
  },
  {
    id: "input-off-boot", group: "input", code: "USER INPUT", title: "关机时按住 1.5 秒", short: "尝试开机与电量判断",
    summary: "关机状态的开机输入会先进行最低电量判断，而不是直接进入开机。",
    targets: ["state-off", "input-off-boot", "decision-off-battery", "sub-pairing", "off-boot-block"], led: "允许：蓝色快闪；拒绝：橙色慢闪", ledClass: "blue-fast",
    rule: "电量 ≥ 20%：进入初始化配网；电量 < 20%：重复橙色慢闪，并回到关机状态。",
    key: "按住 1.5 秒。", buzzer: "满足开机条件后播放上升和旋 3 音节。", tone: "neutral",
  },
  {
    id: "input-factory-reset", group: "input", code: "USER INPUT", title: "关机时恢复出厂", short: "6 秒 → USB → 6 秒",
    summary: "这是只在关机状态可执行的受保护输入序列。",
    targets: ["state-off", "input-factory-reset", "sub-pairing"], led: "LED 未指定（待确认）", ledClass: "neutral",
    rule: "关机状态按住 6 秒，随后插入 USB 并再保持 6 秒；操作成功后进入初始化配网。",
    key: "必须连续完成全部动作。", buzzer: "滴 1 声。", tone: "neutral",
  },
  {
    id: "input-on-key", group: "input", code: "USER INPUT", title: "开机态按键操作", short: "1.5 秒关机 / 6 秒配网",
    summary: "开机基础运行、调试模式和用户程序运行共享两条长按规则。",
    targets: ["state-on", "sub-debug", "sub-program", "input-on-key", "state-off", "sub-pairing"], led: "随目标状态切换", ledClass: "neutral",
    rule: "按住 1.5 秒进入关机；按住 6 秒进入初始化配网。升级中锁定按键；Error 状态仅接受关机。",
    key: "按住 1.5 秒或 6 秒。", buzzer: "关机时播放下降和旋 3 音节。", tone: "neutral",
  },
  {
    id: "input-sleep-boot", group: "input", code: "USER INPUT", title: "休眠时按住 1.5 秒", short: "尝试唤醒与低电量判断",
    summary: "休眠状态的开机输入同样先判断是否为低电量休眠。",
    targets: ["state-sleep", "input-sleep-boot", "decision-sleep-battery", "sub-pairing", "sleep-boot-block"], led: "允许：蓝色快闪；拒绝：橙色慢闪", ledClass: "orange-slow",
    rule: "普通休眠：进入初始化配网；低电量休眠：重复橙色慢闪，保持休眠。",
    key: "按住 1.5 秒。", buzzer: "满足开机条件后播放上升和旋 3 音节。", tone: "neutral",
  },
  {
    id: "input-hotplug", group: "input", code: "SYSTEM EVENT", title: "外设热插入", short: "用户程序保持运行",
    summary: "外设插入是用户程序运行中的局部事件；不会切换系统主状态或 LED 输出。",
    targets: ["sub-program", "input-hotplug"], led: "维持白色常亮", ledClass: "white-steady",
    rule: "用户程序继续运行，外设事件仅触发短促提示音。", key: "不需要按键。", buzzer: "短促上升和弦，2 音节。", tone: "neutral",
  },
  {
    id: "alert-low", group: "alert", code: "ALERT OVERLAY", title: "低电量告警", short: "电量 < 20%",
    summary: "低电量告警是开机状态上的 LED 覆盖层，不改写初始化、调试或用户程序逻辑。",
    targets: ["state-on", "sub-pairing", "sub-debug", "sub-program", "alert-low"], led: "橙色慢闪", ledClass: "orange-slow",
    rule: "覆盖所有开机子状态的 LED；告警解除后恢复当前底层状态原本的 LED 输出。",
    key: "沿用被覆盖开机子状态的按键规则。", buzzer: "未指定。", tone: "neutral",
  },
  {
    id: "alert-critical", group: "alert", code: "ALERT OVERLAY", title: "临界低电量", short: "电量 < 5% / 10 秒倒计时",
    summary: "临界低电量是低电量告警的升级分支，随后强制进入低电量休眠。",
    targets: ["alert-low", "alert-critical", "state-sleep"], led: "橙色快闪 10 秒", ledClass: "orange-fast",
    rule: "快闪 10 秒后退出开机态并进入休眠；进入后按低电量休眠规则拒绝启动。",
    key: "倒计时期间的额外按键优先级原始规则未定义，保留为待确认。", buzzer: "未指定。", tone: "neutral",
  },
  {
    id: "exception-upgrade", group: "exception", code: "SYSTEM EXCEPTION", title: "升级中", short: "不可打断的系统操作",
    summary: "升级是临时异常保护状态，完成后回到进入升级前的开机基础状态或子状态。",
    targets: ["state-on", "sub-debug", "sub-program", "exception-upgrade"], led: "红色慢闪", ledClass: "red-slow",
    rule: "系统升级等不可中断操作期间，原运行上下文被冻结并在完成后恢复。", key: "所有按键操作均不响应。", buzzer: "未指定。", tone: "neutral",
  },
  {
    id: "exception-error", group: "exception", code: "SYSTEM EXCEPTION", title: "其他 Error 状态", short: "高温 / 系统无法正常工作",
    summary: "高温或系统无法正常工作时进入错误保护；错误态仅保留关机操作。",
    targets: ["state-on", "sub-pairing", "sub-debug", "sub-program", "exception-error", "state-off"], led: "红色快闪", ledClass: "red-fast",
    rule: "Error LED 优先于所有正常运行与告警 LED。关机完成后回到关机状态。", key: "仅响应关机操作。", buzzer: "与恢复出厂相同音调音节，短促连续播放 3 遍。", tone: "neutral",
  },
  {
    id: "charge-battery", group: "charging", code: "CHARGE OVERLAY", title: "USB 充电（有电池）", short: "仅关机 / 休眠显示",
    summary: "充电不是单独的系统状态，只在关机或休眠且检测到电池时覆盖 LED。",
    targets: ["state-off", "state-sleep", "charge-battery"], led: "充电中：橙色常亮；充满：绿色常亮", ledClass: "orange-steady",
    rule: "所有开机状态均不通过 LED 显示充电状态。", key: "不改变关机或休眠的允许输入。", buzzer: "未指定。", tone: "neutral",
  },
  {
    id: "charge-nobattery", group: "charging", code: "CHARGE OVERLAY", title: "USB 接入（无电池）", short: "不显示充电颜色",
    summary: "关机或休眠状态接入 USB 但未检测到电池时，不显示充电专用颜色。",
    targets: ["state-off", "state-sleep", "charge-nobattery"], led: "维持系统基础状态显示", ledClass: "off",
    rule: "无电池时不显示橙色或绿色充电色，只显示关机 / 休眠本身的基础 LED 输出。", key: "不改变关机或休眠的允许输入。", buzzer: "未指定。", tone: "neutral",
  },
];

const groups = [
  { id: "system", label: "系统主状态", description: "关机、开机、休眠" },
  { id: "substate", label: "开机子状态", description: "配网、调试、用户程序" },
  { id: "input", label: "用户输入 / 事件", description: "长按、恢复出厂、热插入" },
  { id: "alert", label: "告警提示态", description: "低电量 LED 覆盖" },
  { id: "exception", label: "系统异常态", description: "升级中、其他 Error" },
  { id: "charging", label: "充电覆盖", description: "仅关机 / 休眠" },
];

const initial = interactions.find((item) => item.id === "state-on")!;
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="ESP-Claw 系统状态、用户输入、逻辑判断、LED 与蜂鸣器策略流程图。" />
    <title>系统状态与 LED 指示策略 | ESP-Claw</title>
  </head>
  <body>
    <main class="system-page">
      <header class="page-header">
        <div class="eyebrow-row">
          <span class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>ESP-CLAW / SYSTEM FLOW</span>
          <span class="revision">三主状态 · REV 0.4 · 2026-09</span>
        </div>
        <div class="hero-grid">
          <div>
            <p class="kicker">STATE · INPUT · DECISION · EFFECT</p>
            <h1>系统状态与 LED 指示策略</h1>
            <p class="hero-copy">从右下方选择状态、输入或事件；上方传统流程图将以<strong>中性反色</strong>定位对应的状态块、输入块与判断块。LED 颜色仅在效果面板中表达，不参与流程图选中态。</p>
          </div>
          <aside class="decision-card" aria-label="页面使用说明">
            <span class="decision-label">阅读方式</span>
            <strong>先选规则，再看反色节点；右侧效果卡给出 LED、按键与蜂鸣器。</strong>
            <p>实线表示状态转换，虚线表示覆盖或共享规则。每条分支均标注明确的成功、拒绝或返回去向。</p>
            <a class="hw-button-primary source-action" href="/led-strategy-flow.mmd" download>
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3v11m0 0 4-4m-4 4-4-4M5 17v3h14v-3" /></svg>
              下载流程图源码
            </a>
            <a class="source-graphic" href="/led-strategy-flow.png" target="_blank" rel="noreferrer">查看可下载流程图 PNG ↗</a>
          </aside>
        </div>
      </header>

      <section class="workspace" aria-label="系统策略流程图与选择器">
        <section class="hw-card flow-card" aria-labelledby="flow-heading">
          <div class="section-heading">
            <div>
              <p class="section-eyebrow">TRADITIONAL FLOWCHART</p>
              <h2 id="flow-heading">完整系统状态、输入与判断流程</h2>
            </div>
            <span class="flow-hint"><i aria-hidden="true"></i>白色反色块为当前规则</span>
          </div>

          <div class="flowchart-wrap" role="img" aria-label="覆盖关机、开机、休眠、配网、调试、用户程序、低电量、升级、错误、充电和蜂鸣器规则的传统流程图">
            <svg class="flowchart" viewBox="0 0 1200 880" aria-hidden="true">
              <defs>
                <marker id="arrow" markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto"><path d="M0,0 L9,4.5 L0,9 Z" fill="#71817B" /></marker>
              </defs>

              <g class="lane-labels">
                <text x="32" y="34">关机启动与恢复出厂</text><text x="32" y="270">休眠唤醒</text><text x="400" y="390">开机运行与子状态</text><text x="32" y="746">低电量保护、异常保护与充电覆盖</text>
              </g>
              <g class="flow-lines" fill="none" stroke="#71817B" stroke-width="1.45" marker-end="url(#arrow)">
                <path d="M177 105 H225" /><path d="M375 105 H405" /><path d="M485 105 H505" />
                <path d="M685 105 C760 105 790 188 832 230" /><path d="M445 145 V177 H440" /><path d="M250 177 H210 V105 H177" />
                <path d="M237 210 H330 V150 H595 V140" />
                <path d="M177 330 H225" /><path d="M375 330 H405" /><path d="M485 330 H505" />
                <path d="M685 330 C735 330 770 290 800 270" /><path d="M445 370 V395 H400" /><path d="M250 420 H210 V365 H177" />
                <path d="M820 308 V360 H490 V420" /><path d="M860 308 V520 H490 V540" /><path d="M960 270 H1010 V420" />
                <path d="M580 456 H595" /><path d="M665 445 H690" /><path d="M630 496 V501 H690" />
                <path d="M580 575 H610 V600 H760" /><path d="M490 610 V660" />
                <path d="M850 610 V308" /><path d="M1010 500 V710 H104 V140" /><path d="M920 460 H720 V365 H685" />
                <path d="M260 805 H310" /><path d="M490 805 H520 V385 H104 V365" />
                <path d="M695 770 V720 H850 V610" /><path d="M990 770 V850 H104 V140" />
                <path d="M960 270 H1080 V735 H695 V770" /><path d="M960 280 H1120 V770 H990" />
              </g>
              <g class="flow-lines flow-lines--dashed" fill="none" stroke="#71817B" stroke-width="1.35" stroke-dasharray="5 5" marker-end="url(#arrow)">
                <path d="M760 270 H700 V735 H170 V770" />
                <path d="M132 500 V180 H104 V140" /><path d="M232 532 H300 V365 H177" />
                <path d="M132 580 V190 H104 V140" /><path d="M232 612 H315 V365 H177" /><path d="M580 456 V390 H850 V308" />
              </g>
              <g class="flow-labels">
                <text x="280" y="93">按住 1.5 秒</text><text x="392" y="93">判断</text><text x="312" y="153">否：橙色慢闪 / 保持关机</text>
                <text x="325" y="197">6 秒 → USB → 再保持 6 秒</text><text x="280" y="318">按住 1.5 秒</text><text x="392" y="318">判断</text><text x="312" y="380">是：橙色慢闪 / 保持休眠</text>
                <text x="742" y="176">配网完成</text><text x="740" y="314">普通休眠</text><text x="645" y="398">进入调试</text><text x="710" y="514">启动用户程序</text><text x="1019" y="390">开机态长按</text>
                <text x="676" y="435">连接？</text><text x="677" y="432">否</text><text x="650" y="498">是</text><text x="697" y="588">任务结束</text><text x="550" y="650">外设热插入</text>
                <text x="810" y="350">退出 / 结束</text><text x="785" y="448">按住 6 秒</text><text x="1022" y="696">按住 1.5 秒</text>
                <text x="285" y="795">电量 &lt; 5%</text><text x="430" y="720">10 秒后 → 低电量休眠</text><text x="790" y="725">不可打断操作</text><text x="1090" y="725">致命错误</text>
                <text x="350" y="445">仅关机 / 休眠：充电覆盖</text><text x="720" y="402">调试退出</text>
              </g>

              <g class="flow-node flow-node--state" data-flow-id="state-off"><rect x="32" y="70" width="145" height="70" rx="10" /><text x="104" y="95" class="node-kicker">SYSTEM STATE</text><text x="104" y="117" class="node-title">01 · 关机</text><text x="104" y="132" class="node-meta">基础 LED：熄灭</text></g>
              <g class="flow-node flow-node--input" data-flow-id="input-off-boot"><rect x="225" y="70" width="150" height="70" rx="10" /><text x="300" y="95" class="node-kicker">USER INPUT</text><text x="300" y="117" class="node-title">按住 1.5 秒</text><text x="300" y="132" class="node-meta">尝试开机</text></g>
