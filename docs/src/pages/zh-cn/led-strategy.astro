          <div class="control-list" aria-label="状态与输入列表">
            {groups.map((group) => (
              <section class="control-group" aria-labelledby={`group-${group.id}`}>
                <div class="control-group-title"><span id={`group-${group.id}`}>{group.label}</span><small>{group.description}</small></div>
                <div class="control-options">
                  {interactions.filter((item) => item.group === group.id).map((item) => (
                    <button type="button" class={`control-option${item.id === initial.id ? " is-selected" : ""}`} data-rule={item.id} aria-pressed={item.id === initial.id ? "true" : "false"}>
                      <span class={`option-mark option-mark--${item.tone}`} aria-hidden="true"></span>
                      <span><strong>{item.title}</strong><small>{item.short}</small></span>
                      <span class="option-arrow" aria-hidden="true">›</span>
                    </button>
