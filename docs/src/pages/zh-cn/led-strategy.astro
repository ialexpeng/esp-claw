          </div>
        </section>

        <aside class="hw-card control-card" aria-labelledby="control-heading" aria-live="polite">
          <div class="control-heading">
            <div><p class="section-eyebrow">STATE / INPUT SELECTOR</p><h2 id="control-heading">选择状态或输入</h2></div>
