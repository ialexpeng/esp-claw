---
import "../../styles/hardware-tokens.css";

const interactions = [
  {
    id: "state-off",
    group: "system",
    code: "SYSTEM STATE",
    title: "关机",
    short: "基础关机",
    summary: "彻底断电，基础 LED 熄灭；只保留开机与恢复出厂的受限输入。",
    targets: ["state-off"],
    led: "LED 熄灭",
    ledClass: "off",
    rule: "未插 USB 时不显示任何运行或充电颜色。USB 充电只在关机 / 休眠时覆盖 LED。",
    key: "响应：开机 1.5 秒；恢复出厂连续动作。",
    buzzer: "无独立提示音。",
    tone: "offline",
  },
  {
    id: "state-on",
    group: "system",
    code: "SYSTEM STATE",
    title: "开机",
    short: "基础运行",
    summary: "系统的基础运行状态；其下进入初始化配网、调试模式或用户程序运行。",
    targets: ["state-on"],
    led: "绿色呼吸（建议）",
    ledClass: "green-breathe",
    rule: "这里表示开机后的基础运行 / Idle。进入子状态后，LED 由相应子状态定义。",
    key: "按住 1.5 秒：关机；按住 6 秒：重新配网。",
    buzzer: "关机时播放下降和旋 3 音节。",
    tone: "accent",
  },
  {
    id: "state-sleep",
    group: "system",
    code: "SYSTEM STATE",
    title: "休眠",
    short: "普通 / 低电量休眠",
    summary: "基础 LED 熄灭，只响应开机操作；低电量休眠时会额外阻止开机。",
    targets: ["state-sleep"],
    led: "LED 熄灭（基础）",
    ledClass: "off",
    rule: "USB + 有电池时，充电中显示橙色常亮，充满显示绿色常亮。",
    key: "普通休眠：按住 1.5 秒开机；低电量休眠：拒绝开机。",
    buzzer: "成功开机后播放上升和旋 3 音节。",
    tone: "offline",
  },
  {
    id: "sub-pairing",
    group: "substate",
    code: "ON SUBSTATE",
    title: "初始化配网",
    short: "初始化 / 未配网",
    summary: "首次开机、恢复出厂或重置配网后进入；完成后回到开机基础运行状态。",
    targets: ["sub-pairing", "state-on"],
    led: "蓝色快闪",
    ledClass: "blue-fast",
    rule: "蓝色快闪表示正在初始化与配网，界面应同步显示“正在配网”。",
    key: "完成配网后自动回到开机基础运行状态。",
    buzzer: "开机入口播放上升和旋 3 音节；配网本身未定义额外音效。",
    tone: "info",
  },
  {
    id: "sub-debug",
    group: "substate",
    code: "ON SUBSTATE",
    title: "调试模式",
    short: "上位机连接状态",
    summary: "调试模式中，上位机是否连接决定不同 LED 子逻辑。",
    targets: ["sub-debug", "state-on"],
    led: "未连接：绿色常亮；已连接：彩虹呼吸",
    ledClass: "rainbow-breathe",
    rule: "彩虹呼吸只用于“调试模式 + 上位机已连接”；断开后切换回绿色常亮。",
    key: "按住 1.5 秒：关机；按住 6 秒：重新配网。",
    buzzer: "关机时播放下降和旋 3 音节。",
    tone: "accent",
  },
  {
    id: "sub-program",
    group: "substate",
    code: "ON SUBSTATE",
    title: "用户程序运行",
    short: "用户任务执行中",
    summary: "用户程序运行期间 LED 白色常亮；任务结束后回到开机基础运行状态。",
    targets: ["sub-program", "state-on"],
    led: "白色常亮",
    ledClass: "white-steady",
    rule: "白色常亮表示用户任务执行中；外设热插入不改变该状态。",
    key: "按住 1.5 秒：关机；按住 6 秒：重新配网。",
    buzzer: "热插入时播放短促上升和弦 2 音节；关机播放下降和旋 3 音节。",
    tone: "accent",
  },
  {
    id: "input-off-boot",
    group: "input",
    code: "USER INPUT",
    title: "关机时按住 1.5 秒",
    short: "尝试开机",
    summary: "在关机状态下触发启动判断；电量不足时不进入开机。",
    targets: ["state-off", "input-off-boot", "decision-off-battery", "sub-pairing"],
    led: "通过：蓝色快闪；阻止：橙色慢闪",
    ledClass: "blue-fast",
    rule: "电量 ≥ 20%：进入初始化配网；电量 < 20%：重复橙色慢闪并保持关机。",
    key: "按住 1.5 秒。",
    buzzer: "允许开机时：上升和旋 3 音节。",
    tone: "info",
  },
  {
    id: "input-factory-reset",
    group: "input",
    code: "USER INPUT",
    title: "关机时恢复出厂",
    short: "长按 + USB",
    summary: "用于清除设置的受保护输入流程。",
    targets: ["state-off", "input-factory-reset", "sub-pairing"],
    led: "LED 未指定（待确认）",
    ledClass: "neutral",
    rule: "关机 → 按住 6 秒 → 插入 USB → 再保持 6 秒；成功后进入初始化配网。",
    key: "必须连续完成全部动作。",
    buzzer: "滴 1 声。",
    tone: "warning",
  },
  {
    id: "input-on-key",
    group: "input",
    code: "USER INPUT",
    title: "开机时按键操作",
    short: "1.5 秒 / 6 秒",
    summary: "开机基础状态、调试模式与用户程序运行共享相同的两条长按逻辑。",
    targets: ["state-on", "sub-debug", "sub-program", "input-on-key", "state-off", "sub-pairing"],
    led: "按目标状态切换",
    ledClass: "neutral",
    rule: "按住 1.5 秒：关机；按住 6 秒：重新进入初始化配网。",
    key: "升级中不响应；Error 仅接受关机操作。",
    buzzer: "关机时播放下降和旋 3 音节。",
    tone: "accent",
  },
  {
    id: "input-sleep-boot",
    group: "input",
    code: "USER INPUT",
    title: "休眠时按住 1.5 秒",
    short: "尝试唤醒",
    summary: "普通休眠可开机；低电量休眠会阻止开机并给出提示。",
    targets: ["state-sleep", "input-sleep-boot", "decision-sleep-battery", "sub-pairing", "alert-low"],
    led: "普通：蓝色快闪；低电量：橙色慢闪",
    ledClass: "orange-slow",
    rule: "普通休眠进入初始化配网；低电量休眠保持休眠，并重复橙色慢闪。",
    key: "按住 1.5 秒。",
    buzzer: "允许开机时：上升和旋 3 音节。",
    tone: "warning",
  },
  {
    id: "alert-low",
    group: "alert",
    code: "ALERT OVERLAY",
    title: "低电量告警",
    short: "告警提示态",
    summary: "仅覆盖当前开机状态的 LED，不改变开机、调试或用户程序的原始逻辑。",
    targets: ["alert-low", "state-on", "sub-debug", "sub-program"],
    led: "电量 < 20%：橙色慢闪",
    ledClass: "orange-slow",
    rule: "告警解除后，恢复当前底层状态原本的 LED 输出。",
    key: "沿用被覆盖的开机子状态按键策略。",
    buzzer: "未指定。",
    tone: "warning",
  },
  {
    id: "alert-critical",
    group: "alert",
    code: "ALERT OVERLAY",
    title: "临界低电量",
    short: "自动休眠倒计时",
    summary: "电量低于 5% 后，告警进入定时保护流程。",
    targets: ["alert-low", "state-sleep"],
    led: "橙色快闪 10 秒",
    ledClass: "orange-fast",
    rule: "快闪 10 秒后，退出开机态并进入低电量休眠。",
    key: "倒计时期间不额外定义按键操作。",
    buzzer: "未指定。",
    tone: "warning",
  },
  {
    id: "exception-upgrade",
    group: "exception",
    code: "SYSTEM EXCEPTION",
    title: "升级中",
    short: "不可打断操作",
    summary: "升级期间为独立的异常保护状态；完成后应回到进入升级前的开机状态。",
    targets: ["exception-upgrade", "state-on", "sub-debug", "sub-program"],
    led: "红色慢闪",
    ledClass: "red-slow",
    rule: "系统升级等不可中断操作进行中，主状态临时进入保护流程。",
    key: "所有按键操作：不响应。",
    buzzer: "未指定。",
    tone: "danger",
  },
  {
    id: "exception-error",
    group: "exception",
    code: "SYSTEM EXCEPTION",
    title: "其他 Error 状态",
    short: "高温 / 系统无法工作",
    summary: "高温或系统无法正常工作时进入错误保护；错误态仅允许关机。",
    targets: ["exception-error", "state-on", "sub-debug", "sub-program", "state-off"],
    led: "红色快闪",
    ledClass: "red-fast",
    rule: "错误 LED 优先于正常运行 LED；完成关机后返回关机状态。",
    key: "仅响应关机操作。",
    buzzer: "与恢复出厂相同的音调音节，短促连续播放 3 遍。",
    tone: "danger",
  },
];

const groups = [
  { id: "system", label: "系统状态", description: "关机、开机、休眠" },
  { id: "substate", label: "开机子状态", description: "初始化配网、调试、用户程序" },
  { id: "input", label: "用户输入", description: "长按、USB 与启动判断" },
  { id: "alert", label: "告警提示态", description: "低电量 LED 覆盖" },
  { id: "exception", label: "系统异常态", description: "升级中、其他 Error" },
];

const initial = interactions.find((item) => item.id === "state-on")!;
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="ESP-Claw 系统状态、用户输入、逻辑判断、LED 与蜂鸣器策略流程图。" />
    <title>系统状态与 LED 指示策略 | ESP-Claw</title>
  </head>
  <body>
    <main class="system-page">
      <header class="page-header">
        <div class="eyebrow-row">
          <span class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>ESP-CLAW / SYSTEM FLOW</span>
          <span class="revision">三主状态 · REV 0.3 · 2026-09</span>
        </div>
        <div class="hero-grid">
          <div>
            <p class="kicker">STATE · INPUT · DECISION · EFFECT</p>
            <h1>系统状态与 LED 指示策略</h1>
            <p class="hero-copy">左侧是包含<strong>状态、用户输入与逻辑判断</strong>的传统流程图；右侧点击任一状态或输入，流程图会同步高亮对应的节点与关联判断块。</p>
          </div>
          <aside class="decision-card" aria-label="页面使用说明">
            <span class="decision-label">阅读方式</span>
            <strong>右侧选择规则，左侧定位流程；效果面板给出 LED、按键与蜂鸣器。</strong>
            <p>低电量是 LED 覆盖提示；升级和 Error 则属于系统异常保护状态。</p>
            <a class="hw-button-primary source-action" href="/led-strategy-flow.mmd" download>
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3v11m0 0 4-4m-4 4-4-4M5 17v3h14v-3" /></svg>
              下载流程图源码
            </a>
            <a class="source-graphic" href="/led-strategy-flow.png" target="_blank" rel="noreferrer">查看传统流程图 PNG ↗</a>
          </aside>
        </div>
      </header>

      <section class="workspace" aria-label="同步状态流程图与策略控制台">
        <section class="hw-card flow-card" aria-labelledby="flow-heading">
          <div class="section-heading">
            <div>
              <p class="section-eyebrow">TRADITIONAL FLOWCHART</p>
              <h2 id="flow-heading">系统状态、输入与判断流程</h2>
            </div>
            <span class="flow-hint"><i aria-hidden="true"></i>绿色描边为当前规则</span>
          </div>

          <div class="flowchart-wrap" role="img" aria-label="关机、开机、休眠、开机子状态、低电量告警及系统异常的传统流程图">
            <svg class="flowchart" viewBox="0 0 1000 760" aria-hidden="true">
              <defs>
                <marker id="arrow" markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto"><path d="M0,0 L9,4.5 L0,9 Z" fill="#71817B" /></marker>
                <marker id="arrow-accent" markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto"><path d="M0,0 L9,4.5 L0,9 Z" fill="#3DE7A6" /></marker>
              </defs>

              <g class="flow-lines" fill="none" stroke="#71817B" stroke-width="1.45" marker-end="url(#arrow)">
                <path d="M190 91 H242" />
                <path d="M378 91 H418" />
                <path d="M500 91 H570" />
                <path d="M190 218 H242" />
                <path d="M378 218 H418" />
                <path d="M500 218 H570" />
                <path d="M651 198 V270" />
                <path d="M495 340 V390 H348 V420" />
                <path d="M585 340 V390 H648 V420" />
                <path d="M420 458 H495" />
                <path d="M720 458 H770" />
                <path d="M495 340 H190 V510" />
                <path d="M510 550 H570" />
                <path d="M650 568 V620 H520" />
                <path d="M720 568 V620 H758" />
                <path d="M690 658 H828" />
                <path d="M908 658 V700 H118 V130" />
                <path d="M850 470 V510" />
              </g>
              <g class="flow-lines flow-lines--dashed" fill="none" stroke="#FFBD59" stroke-width="1.35" stroke-dasharray="5 5" marker-end="url(#arrow)">
                <path d="M720 458 H850" />
                <path d="M838 340 V405 H850" />
                <path d="M720 490 H850" />
              </g>
              <g class="flow-labels">
                <text x="205" y="78">按住 1.5 秒</text><text x="387" y="78">电量判断</text>
                <text x="205" y="205">按住 1.5 秒</text><text x="387" y="205">电量判断</text>
                <text x="672" y="253">配网完成</text><text x="365" y="380">进入调试</text><text x="622" y="380">启动任务</text>
                <text x="255" y="496">长按 1.5 秒关机</text><text x="525" y="537">按住 6 秒</text>
                <text x="730" y="608">不可打断操作</text><text x="846" y="608">致命错误</text>
                <text x="864" y="497">低于 5%：10 秒</text>
              </g>

              <g class="flow-node flow-node--offline" data-flow-id="state-off">
                <rect x="35" y="55" width="155" height="72" rx="10" /><text x="112" y="82" class="node-kicker">SYSTEM STATE</text><text x="112" y="105" class="node-title">01 · 关机</text><text x="112" y="119" class="node-meta">基础 LED：熄灭</text>
              </g>
              <g class="flow-node flow-node--input" data-flow-id="input-off-boot">
                <rect x="242" y="55" width="136" height="72" rx="10" /><text x="310" y="82" class="node-kicker">USER INPUT</text><text x="310" y="105" class="node-title">按住 1.5 秒</text><text x="310" y="119" class="node-meta">尝试开机</text>
              </g>
              <g class="flow-node flow-node--decision" data-flow-id="decision-off-battery">
                <path d="M459 45 L500 91 L459 137 L418 91 Z" /><text x="459" y="84" class="node-kicker">电量 ≥</text><text x="459" y="102" class="node-title">20%？</text>
              </g>
              <g class="flow-node flow-node--info" data-flow-id="sub-pairing">
                <rect x="570" y="55" width="162" height="72" rx="10" /><text x="651" y="82" class="node-kicker">ON SUBSTATE</text><text x="651" y="105" class="node-title">初始化配网</text><text x="651" y="119" class="node-meta">LED：蓝色快闪</text>
              </g>
              <g class="flow-node flow-node--input" data-flow-id="input-factory-reset">
                <rect x="780" y="55" width="177" height="72" rx="10" /><text x="868" y="80" class="node-kicker">USER INPUT</text><text x="868" y="101" class="node-title">恢复出厂</text><text x="868" y="117" class="node-meta">6 秒 → USB → 6 秒</text>
              </g>

              <g class="flow-node flow-node--offline" data-flow-id="state-sleep">
                <rect x="35" y="182" width="155" height="72" rx="10" /><text x="112" y="209" class="node-kicker">SYSTEM STATE</text><text x="112" y="232" class="node-title">03 · 休眠</text><text x="112" y="246" class="node-meta">基础 LED：熄灭</text>
              </g>
              <g class="flow-node flow-node--input" data-flow-id="input-sleep-boot">
                <rect x="242" y="182" width="136" height="72" rx="10" /><text x="310" y="209" class="node-kicker">USER INPUT</text><text x="310" y="232" class="node-title">按住 1.5 秒</text><text x="310" y="246" class="node-meta">尝试唤醒</text>
              </g>
              <g class="flow-node flow-node--decision" data-flow-id="decision-sleep-battery">
                <path d="M459 172 L500 218 L459 264 L418 218 Z" /><text x="459" y="211" class="node-kicker">低电量</text><text x="459" y="229" class="node-title">休眠？</text>
              </g>
              <g class="flow-node flow-node--warning" data-flow-id="alert-low">
                <rect x="780" y="182" width="177" height="72" rx="10" /><text x="868" y="209" class="node-kicker">ALERT OVERLAY</text><text x="868" y="232" class="node-title">低电量告警</text><text x="868" y="246" class="node-meta">仅覆盖 LED</text>
              </g>

              <g class="flow-node flow-node--accent" data-flow-id="state-on">
                <rect x="405" y="270" width="180" height="70" rx="10" /><text x="495" y="296" class="node-kicker">SYSTEM STATE</text><text x="495" y="318" class="node-title">02 · 开机（基础运行）</text><text x="495" y="332" class="node-meta">LED：绿色呼吸（建议）</text>
              </g>
              <g class="flow-node flow-node--accent" data-flow-id="sub-debug">
                <rect x="250" y="420" width="170" height="76" rx="10" /><text x="335" y="446" class="node-kicker">ON SUBSTATE</text><text x="335" y="468" class="node-title">调试模式</text><text x="335" y="484" class="node-meta">未连：绿常亮 / 已连：彩虹呼吸</text>
              </g>
              <g class="flow-node flow-node--accent" data-flow-id="sub-program">
                <rect x="495" y="420" width="225" height="76" rx="10" /><text x="607" y="446" class="node-kicker">ON SUBSTATE</text><text x="607" y="468" class="node-title">用户程序运行</text><text x="607" y="484" class="node-meta">LED：白色常亮</text>
              </g>
              <g class="flow-node flow-node--input" data-flow-id="input-on-key">
                <rect x="35" y="510" width="155" height="72" rx="10" /><text x="112" y="537" class="node-kicker">USER INPUT</text><text x="112" y="560" class="node-title">开机时长按</text><text x="112" y="574" class="node-meta">1.5 秒关机 / 6 秒配网</text>
              </g>
              <g class="flow-node flow-node--info" data-flow-id="sub-pairing">
                <rect x="570" y="510" width="160" height="72" rx="10" /><text x="650" y="537" class="node-kicker">ON SUBSTATE</text><text x="650" y="560" class="node-title">重新初始化配网</text><text x="650" y="574" class="node-meta">LED：蓝色快闪</text>
              </g>
              <g class="flow-node flow-node--danger" data-flow-id="exception-upgrade">
                <rect x="290" y="620" width="230" height="76" rx="10" /><text x="405" y="646" class="node-kicker">SYSTEM EXCEPTION</text><text x="405" y="668" class="node-title">升级中</text><text x="405" y="684" class="node-meta">红色慢闪 / 按键不响应</text>
              </g>
              <g class="flow-node flow-node--danger" data-flow-id="exception-error">
                <rect x="758" y="620" width="150" height="76" rx="10" /><text x="833" y="646" class="node-kicker">SYSTEM EXCEPTION</text><text x="833" y="668" class="node-title">其他 Error</text><text x="833" y="684" class="node-meta">红色快闪 / 仅关机</text>
              </g>
              <g class="flow-node flow-node--warning" data-flow-id="alert-low">
                <rect x="850" y="405" width="110" height="65" rx="10" /><text x="905" y="430" class="node-kicker">LOW BAT</text><text x="905" y="451" class="node-title">电量 &lt; 5%</text><text x="905" y="465" class="node-meta">橙色快闪</text>
