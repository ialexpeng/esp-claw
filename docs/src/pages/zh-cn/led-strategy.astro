---
import "../../styles/hardware-tokens.css";

const groups = [
  { id: "power", index: "01", title: "电源域", subtitle: "关机与休眠只接受有限操作" },
  { id: "boot", index: "02", title: "启动与配置", subtitle: "开机、恢复出厂与配网" },
  { id: "normal", index: "03", title: "系统正常", subtitle: "运行态可关机或重置配网" },
  { id: "exception", index: "04", title: "提示与异常", subtitle: "按优先级覆盖正常运行态" },
  { id: "charge", index: "05", title: "充电覆盖层", subtitle: "仅在关机或休眠时生效，不是独立系统状态" },
];

const systemStates = [
  {
    id: "power-off",
    group: "power",
    label: "POWER OFF",
    title: "关机 / 彻底断电",
    summary: "LED 熄灭，只保留开机与恢复出厂的按钮侦测。",
    led: "熄灭",
    ledDetail: "基础状态不点亮 LED。插入 USB 时，由充电覆盖层决定是否显示充电色。",
    ledClass: "off",
    tone: "offline",
    button: ["按住 1.5 秒：开机", "按住 6 秒 → 插入 USB → 再保持 6 秒：恢复出厂设置"],
    transitions: ["按住 1.5 秒 → 开机音 → 初始化配网", "电量低于 20% → 拒绝开机，并重复橙色慢闪", "插入 USB → 进入充电覆盖逻辑"],
    buzzer: "无独立提示音；开机后播放上升和旋 3 音节。",
    note: "低于 20% 的开机限制属于关机态启动守卫，不改变关机的基础 LED 定义。",
  },
  {
    id: "sleep",
    group: "power",
    label: "SLEEP",
    title: "系统休眠",
    summary: "基础 LED 熄灭，只响应开机操作；USB 充电可覆盖灯效。",
    led: "熄灭（基础）",
    ledDetail: "在未充电时维持熄灭。USB + 有电池时显示充电颜色；无电池时保持系统状态色。",
    ledClass: "off",
    tone: "offline",
    button: ["按住 1.5 秒：开机"],
    transitions: ["按住 1.5 秒 → 开机音 → 初始化配网", "低电量休眠 → 启动被阻止", "插入 USB → 进入充电覆盖逻辑"],
    buzzer: "无独立提示音；成功开机后播放上升和旋 3 音节。",
    note: "休眠和关机共享充电显示边界：开机状态不通过 LED 显示充电状态。",
  },
  {
    id: "low-sleep",
    group: "power",
    label: "LOW POWER SLEEP",
    title: "低电量休眠",
    summary: "因低电量进入休眠后，按住 1.5 秒不能开机。",
    led: "橙色慢闪（反馈）",
    ledDetail: "用户尝试开机时重复橙色慢闪，明确提示电量不足而不是静默失败。",
    ledClass: "orange-slow",
    tone: "warning",
    button: ["按住 1.5 秒：拒绝开机，并重复橙色慢闪"],
    transitions: ["连接 USB 且有电池 → 充电覆盖层", "充电满足启动条件后 → 按正常开机路径"],
    buzzer: "未指定；页面不推定额外蜂鸣器。",
    note: "此节点表示低电量休眠的按键结果，避免与普通休眠的可开机路径混淆。",
  },
  {
    id: "startup",
    group: "boot",
    label: "BOOT",
    title: "开机序列",
    summary: "按键满足 1.5 秒后启动，随后进入系统初始化与配网。",
    led: "交由下一阶段定义",
    ledDetail: "输入策略没有给出独立的开机过渡色；本图不新增未定义灯效。",
    ledClass: "neutral",
    tone: "info",
    button: ["开机过程中不单列按键策略"],
    transitions: ["关机 / 普通休眠按住 1.5 秒 → 开机序列", "开机序列 → 初始化配网"],
    buzzer: "上升和旋 3 音节，参考 DJI Inspire 无人机开机的听感方向。",
    note: "开机音与最终工作态 LED 分开表达，避免蜂鸣器与 LED 时序相互覆盖。",
  },
  {
    id: "factory-reset",
    group: "boot",
    label: "FACTORY RESET",
    title: "恢复出厂设置",
    summary: "关机状态的受保护操作，需要长按、插入 USB、再次保持的连续动作。",
    led: "未指定（需确认）",
    ledDetail: "需求只规定恢复出厂时的蜂鸣器，未指定 LED 颜色或闪烁节奏。",
    ledClass: "neutral",
    tone: "warning",
    button: ["关机 → 按住 6 秒 → 插入 USB → 再保持 6 秒"],
    transitions: ["触发成功 → 清除设置 → 初始化配网"],
    buzzer: "滴 1 声。",
    note: "这是待产品确认的 LED 缺口；页面有意保留为“未指定”，不以颜色暗示默认结果。",
  },
  {
    id: "pairing",
    group: "boot",
    label: "NETWORK SETUP",
    title: "系统初始化配网",
    summary: "启动后进行配网，完成后进入正常 Idle。",
    led: "蓝色快闪",
    ledDetail: "蓝色快闪表示初始化与配网过程，必须同时显示“正在配网”文字。",
    ledClass: "blue-fast",
    tone: "info",
    button: ["未定义额外按键操作"],
    transitions: ["开机序列 → 初始化配网", "恢复出厂完成 → 初始化配网", "配网完成 → Idle"],
    buzzer: "未指定；页面不推定额外蜂鸣器。",
    note: "此前双击重置配网已被“按住 6 秒”替代；本图以长按策略为准。",
  },
  {
    id: "idle",
    group: "normal",
    label: "IDLE",
    title: "系统正常 / Idle",
    summary: "常规待机与空闲态；将原“LED 熄灭（待定）”建模为绿色呼吸建议。",
    led: "绿色呼吸（建议）",
    ledDetail: "建议采用低幅绿色呼吸，替代原先待定的熄灭策略，以表达设备已正常运行。",
    ledClass: "green-breathe",
    tone: "accent",
    button: ["按住 1.5 秒：关机", "按住 6 秒：重置配网"],
    transitions: ["启动配网完成 → Idle", "运行任务 → 用户程序", "进入调试 → 调试模式", "低电量 / 告警 / 异常 → 对应高优先级状态"],
    buzzer: "关机时播放下降和旋 3 音节。",
    note: "绿色仅代表“设备正常可用”，不承担充电显示。若量产决定保留熄灭，可把此节点的 LED 策略改为熄灭而不影响其他转移。",
  },
  {
    id: "user-program",
    group: "normal",
    label: "USER PROGRAM",
    title: "系统正常 / 用户程序",
    summary: "用户程序运行中，白色常亮作为工作态指示。",
    led: "白色常亮",
    ledDetail: "白色常亮明确表示用户程序正在运行；充电状态不在开机态叠加显示。",
    ledClass: "white-steady",
    tone: "accent",
    button: ["按住 1.5 秒：关机", "按住 6 秒：重置配网"],
    transitions: ["Idle 启动任务 → 用户程序", "程序结束 → Idle", "低电量 / 告警 / 异常 → 对应高优先级状态"],
    buzzer: "关机时播放下降和旋 3 音节；外设热插入播放短促上升和弦 2 音节。",
    note: "此处的“用户程序”是普通开机运行态，因此完整支持 1.5 秒关机与 6 秒重置配网。",
  },
  {
    id: "debug-disconnected",
    group: "normal",
    label: "DEBUG / HOST OFFLINE",
    title: "调试模式 / 上位机未连接",
    summary: "调试功能启用但上位机未连接，维持绿色常亮。",
    led: "绿色常亮",
    ledDetail: "绿色常亮表示调试模式已就绪，但不能作为“上位机已连接”的唯一提示。",
    ledClass: "green-steady",
    tone: "accent",
    button: ["按住 1.5 秒：关机", "按住 6 秒：重置配网"],
    transitions: ["进入调试 → 调试模式（上位机未连接）", "上位机连接 → 彩虹呼吸", "低电量 / 告警 / 异常 → 对应高优先级状态"],
    buzzer: "关机时播放下降和旋 3 音节。",
    note: "连接与未连接使用不同光效，避免把绿色常亮误读为主机已经连接。",
  },
  {
    id: "debug-connected",
    group: "normal",
    label: "DEBUG / HOST LINKED",
    title: "调试模式 / 上位机已连接",
    summary: "调试模式与上位机链路同时成立时，显示彩虹呼吸。",
    led: "彩虹呼吸",
    ledDetail: "彩虹呼吸仅用于“调试 + 上位机已连接”这一组合状态，并须配合连接文字。",
    ledClass: "rainbow-breathe",
    tone: "accent",
    button: ["按住 1.5 秒：关机", "按住 6 秒：重置配网"],
    transitions: ["上位机连接 → 彩虹呼吸", "上位机断开 → 绿色常亮", "低电量 / 告警 / 异常 → 对应高优先级状态"],
    buzzer: "关机时播放下降和旋 3 音节。",
    note: "彩虹为明确的调试连接信号，不用于其他成功或充电状态。",
  },
  {
    id: "notice",
    group: "exception",
    label: "NOTICE",
    title: "系统提示 / 提醒级",
    summary: "电量低于 20% 及其他弱提示，系统仍可继续工作。",
    led: "橙色慢闪",
    ledDetail: "橙色慢闪表示需要关注但非立即中断；结合文字说明提示来源。",
    ledClass: "orange-slow",
    tone: "warning",
    button: ["未改变正常运行态的按键策略"],
    transitions: ["电量低于 20% 等弱提示 → 提醒级提示", "电量低于 5% → 橙色快闪 10 秒 → 系统休眠"],
    buzzer: "未指定；页面不推定额外蜂鸣器。",
    note: "提醒是对正常态的提示覆盖；程序 / 调试状态的业务逻辑仍可恢复。",
  },
  {
    id: "critical-low",
    group: "exception",
    label: "CRITICAL LOW BATTERY",
    title: "临界低电量倒计时",
    summary: "电量低于 5% 时，橙色快闪 10 秒后转入系统休眠。",
    led: "橙色快闪 10 秒",
    ledDetail: "快闪时长固定为 10 秒；该倒计时结束后系统进入休眠，不继续停留在临界低电量态。",
    ledClass: "orange-fast",
    tone: "warning",
    button: ["倒计时期间未定义额外按键策略"],
    transitions: ["提醒级提示 + 电量低于 5% → 本状态", "10 秒后 → 系统休眠", "休眠后按 1.5 秒但电量不足 → 拒绝开机 / 橙色慢闪"],
    buzzer: "未指定；页面不推定额外蜂鸣器。",
    note: "把“10 秒”放在状态转移中，而非单独 LED 配置中，便于固件实现可测的计时行为。",
  },
  {
    id: "upgrade",
    group: "exception",
    label: "WARNING / UPGRADE",
    title: "系统告警 / 系统升级",
    summary: "不可中断操作进行中，按键全部不响应。",
    led: "红色慢闪",
    ledDetail: "产品策略将升级等不可打断流程标记为红色慢闪；旁边必须明确写出“不可打断”。",
    ledClass: "red-slow",
    tone: "danger",
    button: ["所有按键操作：不响应"],
    transitions: ["升级或不可打断操作开始 → 本状态", "操作完成 → 回到之前的正常运行态（默认 Idle）"],
    buzzer: "未指定；页面不推定额外蜂鸣器。",
    note: "虽然名称为 Warning，但 LED 色由原始需求指定为红色；本页保留该产品语义。",
  },
  {
    id: "error",
    group: "exception",
    label: "ERROR",
    title: "系统异常 / Error",
    summary: "高温或系统无法正常工作的错误态；只允许关机。",
    led: "红色快闪",
    ledDetail: "红色快闪与错误文字共同提示不可继续运行；快速反馈在减少动态效果模式下会静止呈现。",
    ledClass: "red-fast",
    tone: "danger",
    button: ["仅响应关机操作", "其他按键：不响应"],
    transitions: ["高温或致命错误 → 本状态", "关机操作 → 关机 / 彻底断电"],
    buzzer: "使用与恢复出厂相同的音调音节，短促连续播放 3 遍。",
    note: "错误态优先于用户程序、调试与普通提醒；诊断日志应由固件另行保留。",
  },
  {
    id: "charge-battery",
    group: "charge",
    label: "USB + BATTERY",
    title: "USB 充电 / 有电池",
    summary: "只在关机或休眠时覆盖 LED；充电中与充满使用不同常亮颜色。",
    led: "充电中橙色常亮 / 充满绿色常亮",
    ledDetail: "充电中显示橙色常亮；检测到充电完成后切换为绿色常亮。开机状态不显示该充电覆盖。",
    ledClass: "charge",
    tone: "warning",
    button: ["不引入额外按键规则；沿用关机 / 休眠的操作范围"],
    transitions: ["关机或休眠 + 插入 USB + 有电池 → 充电覆盖", "拔出 USB → 回到基础系统 LED", "设备开机 → 隐藏充电覆盖，显示当前开机态 LED"],
    buzzer: "未指定；页面不推定插入 USB 的蜂鸣器。",
    note: "充电是显示覆盖层，不应在状态机中替代关机或休眠节点。",
  },
  {
    id: "charge-no-battery",
    group: "charge",
    label: "USB / NO BATTERY",
    title: "USB 充电 / 无电池",
    summary: "不显示充电颜色，只保留当前系统状态颜色。",
    led: "保持系统状态颜色",
    ledDetail: "无电池时不点亮橙色或绿色充电色；在关机 / 休眠基础态中通常仍为熄灭。",
    ledClass: "neutral",
    tone: "offline",
    button: ["不引入额外按键规则；沿用关机 / 休眠的操作范围"],
    transitions: ["关机或休眠 + 插入 USB + 无电池 → 本覆盖逻辑", "插入电池 → 切换到 USB + 有电池策略", "设备开机 → 仅显示当前开机态 LED"],
    buzzer: "未指定；页面不推定额外蜂鸣器。",
    note: "“无电池”不是充电失败提示；它的核心规则是禁止误导性的充电灯色。",
  },
];

const initialState = systemStates.find((state) => state.id === "idle")!;
const stateGroups = groups.map((group) => ({
  ...group,
  states: systemStates.filter((state) => state.group === group.id),
}));
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="ESP-Claw 系统状态、LED 指示灯、按键与蜂鸣器策略交互图。" />
    <title>系统状态与 LED 指示策略 | ESP-Claw</title>
  </head>
  <body>
    <main class="system-page">
      <header class="page-header">
        <div class="eyebrow-row">
          <span class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>ESP-CLAW / DEVICE POLICY</span>
          <span class="revision">策略图 · REV 0.1 · 2026-09</span>
        </div>
        <div class="hero-grid">
          <div>
            <p class="kicker">SYSTEM STATE REFERENCE</p>
            <h1>系统状态与 LED 指示策略</h1>
            <p class="hero-copy">点击状态节点，联动查看 <strong>LED 表现、按键响应、转移条件与蜂鸣器</strong>。充电被建模为只在关机与休眠状态生效的显示覆盖层，而非独立系统状态。</p>
          </div>
          <aside class="decision-card" aria-label="页面使用说明">
            <span class="decision-label">首要阅读动作</span>
            <strong>选择一个状态，核对其输入、输出与离开条件。</strong>
            <p>状态颜色始终配合文字与图标，避免只靠灯色判断。</p>
            <a class="hw-button-primary source-action" href="/led-strategy-flow.mmd" download>
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3v11m0 0 4-4m-4 4-4-4M5 17v3h14v-3" /></svg>
              下载可编辑流程图
            </a>
            <a class="source-graphic" href="/led-strategy-flow.png" target="_blank" rel="noreferrer">查看传统流程图 PNG ↗</a>
          </aside>
        </div>
      </header>

      <section class="strategy-summary" aria-label="策略总览">
        <div class="summary-item">
          <span class="summary-icon summary-icon--green" aria-hidden="true">01</span>
          <div><strong>运行态</strong><span>Idle / 用户程序 / 调试</span></div>
        </div>
        <div class="summary-item">
          <span class="summary-icon summary-icon--orange" aria-hidden="true">02</span>
          <div><strong>提醒优先</strong><span>低电量覆盖正常提示</span></div>
        </div>
        <div class="summary-item">
          <span class="summary-icon summary-icon--red" aria-hidden="true">03</span>
          <div><strong>保护优先</strong><span>升级锁键 / 错误仅可关机</span></div>
        </div>
        <div class="summary-item">
          <span class="summary-icon summary-icon--blue" aria-hidden="true">04</span>
          <div><strong>充电是覆盖层</strong><span>仅关机 / 休眠显示</span></div>
        </div>
      </section>

      <section class="workspace" aria-label="交互式状态策略画布">
        <section class="hw-card flow-card" aria-labelledby="flow-heading">
          <div class="section-heading">
            <div>
              <p class="section-eyebrow">INTERACTIVE FLOW MAP</p>
              <h2 id="flow-heading">状态流与输出策略</h2>
            </div>
            <div class="filter-set" role="toolbar" aria-label="筛选状态域">
              <button class="filter-button is-active" type="button" data-filter="all" aria-pressed="true">全部</button>
              {groups.map((group) => <button class="filter-button" type="button" data-filter={group.id} aria-pressed="false">{group.title}</button>)}
            </div>
          </div>

          <div class="legend" aria-label="LED 图例">
            <span class="legend-title">LED 语义</span>
            <span class="legend-item"><i class="mini-led mini-led--green" aria-hidden="true"></i>正常 / 可用</span>
            <span class="legend-item"><i class="mini-led mini-led--blue" aria-hidden="true"></i>初始化配网</span>
            <span class="legend-item"><i class="mini-led mini-led--orange" aria-hidden="true"></i>提醒 / 低电量</span>
            <span class="legend-item"><i class="mini-led mini-led--red" aria-hidden="true"></i>告警 / 错误</span>
            <span class="legend-item"><i class="mini-led mini-led--gray" aria-hidden="true"></i>熄灭 / 未指定</span>
          </div>

          <div class="route-strip" aria-label="主路径摘要">
            <button type="button" class="route-node" data-state="power-off">关机</button>
            <span class="route-arrow"><span>按住 1.5 秒</span><i aria-hidden="true"></i></span>
            <button type="button" class="route-node" data-state="startup">开机序列</button>
            <span class="route-arrow"><span>初始化</span><i aria-hidden="true"></i></span>
            <button type="button" class="route-node" data-state="pairing">配网</button>
            <span class="route-arrow"><span>完成</span><i aria-hidden="true"></i></span>
            <button type="button" class="route-node route-node--active" data-state="idle">Idle</button>
          </div>

          <div class="flow-map">
            {stateGroups.map((group) => (
              <section class={`flow-group flow-group--${group.id}`} data-flow-group={group.id} aria-labelledby={`group-${group.id}`}>
                <div class="group-heading">
                  <span class="group-index">{group.index}</span>
                  <div><h3 id={`group-${group.id}`}>{group.title}</h3><p>{group.subtitle}</p></div>
                </div>
                <div class="node-stack">
                  {group.states.map((state) => (
                    <button
                      type="button"
                      class={`state-node state-node--${state.tone}${state.id === initialState.id ? " is-selected" : ""}`}
                      data-state={state.id}
                      data-state-group={state.group}
                      aria-pressed={state.id === initialState.id ? "true" : "false"}
                    >
                      <span class={`led-lamp led-lamp--${state.ledClass}`} aria-hidden="true"><span></span></span>
                      <span class="node-content">
                        <span class="node-label">{state.label}</span>
                        <strong>{state.title}</strong>
                        <span class="node-led">{state.led}</span>
                      </span>
                      <svg class="node-chevron" aria-hidden="true" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6" /></svg>
                    </button>
                  ))}
                </div>
              </section>
            ))}
          </div>

          <div class="flow-notes" aria-label="重要转移规则">
            <div class="flow-note"><span class="rule-code">PWR-01</span><p><strong>关机 / 休眠 + USB</strong>：仅有电池时才显示充电中的橙色常亮或充满后的绿色常亮。</p></div>
            <div class="flow-note"><span class="rule-code">KEY-06</span><p><strong>开机正常态</strong>：1.5 秒关机；6 秒重置配网。升级锁键，错误仅允许关机。</p></div>
            <div class="flow-note"><span class="rule-code">LOW-05</span><p><strong>电量 &lt; 5%</strong>：橙色快闪 10 秒，然后进入休眠；低电量休眠不可直接开机。</p></div>
          </div>
        </section>

        <aside class="hw-card detail-card" aria-labelledby="detail-heading" aria-live="polite">
          <div class="detail-topline">
            <span id="detail-group" class="detail-group">正常运行态</span>
            <span id="detail-state-code" class="detail-code">IDLE</span>
          </div>
          <div class="detail-title-row">
            <div>
              <h2 id="detail-heading" tabindex="-1">{initialState.title}</h2>
              <p id="detail-summary">{initialState.summary}</p>
            </div>
            <span id="detail-tone" class="detail-tone detail-tone--accent" aria-hidden="true"></span>
          </div>

          <section class="led-output" aria-label="当前 LED 输出">
            <div class="led-output-heading"><span>LED OUTPUT</span><strong id="detail-led-label">{initialState.led}</strong></div>
            <div class="led-visual">
              <span id="detail-led" class={`led-preview led-preview--${initialState.ledClass}`} aria-hidden="true"><span></span></span>
              <p id="detail-led-detail">{initialState.ledDetail}</p>
            </div>
            <div id="charge-mode" class="charge-mode" hidden>
              <span><i class="mini-led mini-led--orange" aria-hidden="true"></i>充电中：橙色常亮</span>
              <span><i class="mini-led mini-led--green" aria-hidden="true"></i>充满：绿色常亮</span>
            </div>
          </section>

          <section class="detail-section">
            <div class="detail-section-heading"><span>BUTTON RESPONSE</span><span class="section-line"></span></div>
            <ul id="detail-button" class="rule-list"></ul>
          </section>
          <section class="detail-section">
            <div class="detail-section-heading"><span>STATE TRANSITIONS</span><span class="section-line"></span></div>
            <ul id="detail-transitions" class="rule-list rule-list--transition"></ul>
          </section>
          <section class="detail-section detail-section--buzzer">
            <div class="detail-section-heading"><span>BUZZER</span><span class="section-line"></span></div>
            <p id="detail-buzzer" class="buzzer-copy"></p>
          </section>
          <p id="detail-note" class="detail-note"></p>
        </aside>
      </section>

      <section class="support-grid" aria-label="按键、蜂鸣器与优先级参考">
        <section class="hw-card support-card" aria-labelledby="button-matrix-heading">
          <div class="section-heading section-heading--compact">
            <div><p class="section-eyebrow">INPUT MATRIX</p><h2 id="button-matrix-heading">按键响应矩阵</h2></div>
            <span class="matrix-note">1.5 秒与 6 秒均为按住时长</span>
          </div>
          <div class="table-wrap">
            <table>
              <thead><tr><th scope="col">状态范围</th><th scope="col">按住 1.5 秒</th><th scope="col">按住 6 秒</th><th scope="col">其他限制</th></tr></thead>
              <tbody>
                <tr><th scope="row">关机</th><td>开机</td><td>插 USB 后再保持 6 秒：恢复出厂</td><td>电量 &lt; 20%：拒绝开机，橙色慢闪</td></tr>
                <tr><th scope="row">休眠</th><td>开机</td><td>未定义</td><td>低电量休眠时，1.5 秒不可开机</td></tr>
                <tr><th scope="row">Idle / 用户程序 / 调试</th><td>关机</td><td>重置配网</td><td>替代旧版“双击重置配网”</td></tr>
                <tr><th scope="row">系统升级</th><td>不响应</td><td>不响应</td><td>不可打断操作</td></tr>
                <tr><th scope="row">系统 Error</th><td>仅关机操作</td><td>不响应</td><td>错误恢复走关机路径</td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <section class="hw-card support-card sound-card" aria-labelledby="sound-heading">
          <div class="section-heading section-heading--compact">
            <div><p class="section-eyebrow">AUDIO PATTERNS</p><h2 id="sound-heading">按键与蜂鸣器</h2></div>
            <span class="sound-chip">非 LED 状态</span>
          </div>
          <div class="sound-list">
            <div class="sound-row"><span class="sound-glyph sound-glyph--up" aria-hidden="true">↗⌁↗</span><div><strong>开机</strong><p>上升和旋 3 音节；参考 DJI Inspire 无人机开机的听感方向。</p></div></div>
            <div class="sound-row"><span class="sound-glyph sound-glyph--down" aria-hidden="true">↘⌁↘</span><div><strong>关机</strong><p>下降和旋 3 音节，将开机声音逆向播放。</p></div></div>
            <div class="sound-row"><span class="sound-glyph" aria-hidden="true">●</span><div><strong>恢复出厂设置</strong><p>短促滴 1 声。</p></div></div>
            <div class="sound-row"><span class="sound-glyph sound-glyph--up" aria-hidden="true">↗↗</span><div><strong>外设热插入</strong><p>短促上升和弦，2 音节。</p></div></div>
            <div class="sound-row"><span class="sound-glyph sound-glyph--error" aria-hidden="true">● ● ●</span><div><strong>系统异常</strong><p>与恢复出厂相同音调音节，短促播放 3 遍。</p></div></div>
          </div>
        </section>
      </section>

      <section class="implementation-note" aria-labelledby="implementation-heading">
        <div class="implementation-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3v8m0 4v6m9-9h-8M3 12h5M18.4 5.6l-2.8 2.8M8.4 15.6l-2.8 2.8m0-12.8 2.8 2.8m5.2 7.2 2.8 2.8" /></svg></div>
        <div><p class="section-eyebrow">IMPLEMENTATION NOTE</p><h2 id="implementation-heading">两项待产品确认</h2><p>本图将 <strong>Idle</strong> 的“LED 熄灭（待定）”按原建议建模为<strong>绿色呼吸</strong>；恢复出厂设置的 <strong>LED 表现</strong>未在输入中定义，因此保留为未指定。确认后只需更新对应节点，不影响整张状态机。</p></div>
        <button class="hw-button-secondary reset-button" type="button" data-reset>回到 Idle</button>
      </section>

      <footer class="page-footer">
        <span>ESP-CLAW · SYSTEM LED POLICY MAP</span>
        <span>交互方式：点击状态节点，或使用键盘 Tab / Enter 浏览。</span>
      </footer>
    </main>

    <script define:vars={{ systemStates, groups }}>
      const catalog = systemStates;
      const groupNames = Object.fromEntries(groups.map((group) => [group.id, group.title]));
      const detail = {
        group: document.querySelector('#detail-group'),
        code: document.querySelector('#detail-state-code'),
        title: document.querySelector('#detail-heading'),
        summary: document.querySelector('#detail-summary'),
        tone: document.querySelector('#detail-tone'),
        ledLabel: document.querySelector('#detail-led-label'),
        led: document.querySelector('#detail-led'),
        ledDetail: document.querySelector('#detail-led-detail'),
        buttons: document.querySelector('#detail-button'),
        transitions: document.querySelector('#detail-transitions'),
        buzzer: document.querySelector('#detail-buzzer'),
        note: document.querySelector('#detail-note'),
        charge: document.querySelector('#charge-mode'),
      };

      const renderList = (element, items, type) => {
        element.innerHTML = items.map((item) => `<li><span class="rule-bullet rule-bullet--${type}" aria-hidden="true"></span><span>${item}</span></li>`).join('');
      };

      const setState = (stateId, shouldFocus = false) => {
        const state = catalog.find((item) => item.id === stateId);
        if (!state) return;

        document.querySelectorAll('[data-state]').forEach((node) => {
          const selected = node.dataset.state === state.id;
          node.classList.toggle('is-selected', selected);
          node.setAttribute('aria-pressed', String(selected));
        });

        detail.group.textContent = groupNames[state.group];
        detail.code.textContent = state.label;
        detail.title.textContent = state.title;
        detail.summary.textContent = state.summary;
        detail.tone.className = `detail-tone detail-tone--${state.tone}`;
        detail.ledLabel.textContent = state.led;
        detail.led.className = `led-preview led-preview--${state.ledClass}`;
        detail.led.innerHTML = '<span></span>';
        detail.ledDetail.textContent = state.ledDetail;
        detail.charge.hidden = state.id !== 'charge-battery';
        detail.buzzer.textContent = state.buzzer;
        detail.note.textContent = state.note;
        renderList(detail.buttons, state.button, 'button');
        renderList(detail.transitions, state.transitions, 'transition');
        window.history.replaceState(null, '', `#${state.id}`);

        if (shouldFocus) detail.title.focus({ preventScroll: true });
      };

      document.querySelectorAll('[data-state]').forEach((node) => {
        node.addEventListener('click', () => setState(node.dataset.state, false));
      });

      document.querySelectorAll('[data-filter]').forEach((button) => {
        button.addEventListener('click', () => {
          const filter = button.dataset.filter;
          document.querySelectorAll('[data-filter]').forEach((item) => {
            const active = item === button;
            item.classList.toggle('is-active', active);
            item.setAttribute('aria-pressed', String(active));
          });
          document.querySelectorAll('[data-flow-group]').forEach((group) => {
            group.classList.toggle('is-filtered-out', filter !== 'all' && group.dataset.flowGroup !== filter);
          });
        });
      });

      document.querySelector('[data-reset]').addEventListener('click', () => setState('idle', true));

      const hashState = window.location.hash.slice(1);
      if (catalog.some((state) => state.id === hashState)) setState(hashState, false);
      else setState('idle', false);
    </script>
  </body>
</html>

